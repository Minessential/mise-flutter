#!/usr/bin/env bash
#MISE description="Lua formatting, shell and workflow lint"
set -euo pipefail
stylua --check metadata.lua hooks lib tests
shellcheck tests/*.sh tests/lib/*.sh mise-tasks/*
actionlint
${PYTHON:-python3} - <<'PY'
import ast
from pathlib import Path
for path in Path('tests').rglob('*.py'):
    ast.parse(path.read_text(), filename=str(path))
PY
